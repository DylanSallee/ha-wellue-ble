{
  "domain": "wellue_ble",
  "name": "Wellue Checkme O2",
  "bluetooth": [
    {
      "connectable": true,
      "local_name": "O2M*"
    },
    {
      "connectable": true,
      "local_name": "Band-WU*"
    }
  ],
  "codeowners": ["@DylanSallee"],
  "config_flow": true,
  "dependencies": ["bluetooth_adapters"],
  "documentation": "https://github.com/DylanSallee/ha-wellue-ble",
  "integration_type": "device",
  "iot_class": "local_polling",
  "issue_tracker": "https://github.com/DylanSallee/ha-wellue-ble/issues",
  "requirements": ["wellue-ble==1.0.0"],
  "version": "0.1.0"
}
